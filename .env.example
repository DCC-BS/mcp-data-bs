# Huwise Explore v2.1 catalog domain.
# Set by whoever deploys this MCP server. Copy this file to .env and fill in.
DATA_PORTAL_DOMAIN=data.bs.ch

# Host header allowed past DNS-rebinding protection on the MCP HTTP endpoint.
# Add the public hostname(s) this deployment is served under (comma-separated,
# port wildcard allowed), e.g. MCP_ALLOWED_HOSTS="mcp.bs.ch:*". Leave empty or
# unset to disable Host validation.
MCP_ALLOWED_HOSTS=
